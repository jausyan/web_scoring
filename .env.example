# ── Firebase (REQUIRED for multi-laptop real-time sync / Netlify) ──
# Copy to .env.local for dev, and add the same keys in Netlify → Site settings → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Local demo mode (used only when Firebase keys above are empty) ──
# Syncs between tabs of the SAME browser only. Good for testing.
VITE_LOCAL_ADMIN_EMAIL=admin@lcc.id
VITE_LOCAL_ADMIN_PASSWORD=lcc2026
VITE_LOCAL_PIN=1234
